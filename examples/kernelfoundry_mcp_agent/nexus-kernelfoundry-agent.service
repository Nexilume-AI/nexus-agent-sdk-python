[Unit]
Description=Nexus KernelFoundry MCP agent
After=default.target

[Service]
Type=simple
WorkingDirectory=/opt/nexus-agents/kernelfoundry-agent
Environment=PYTHONPATH=/opt/nexus-agents/sdk/src
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/nexus-agents/kernelfoundry-agent/agent.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
UMask=0077

[Install]
WantedBy=default.target
