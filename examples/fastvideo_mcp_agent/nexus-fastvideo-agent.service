[Unit]
Description=Nexus FastVideo Distillation MCP Agent (caller-bound model distillation)
After=default.target

[Service]
Type=simple
WorkingDirectory=/opt/nexus-agents/fastvideo-agent
Environment=PYTHONPATH=/opt/nexus-agents/sdk/src
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/nexus-agents/fastvideo-agent/agent.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
UMask=0077

[Install]
WantedBy=default.target
