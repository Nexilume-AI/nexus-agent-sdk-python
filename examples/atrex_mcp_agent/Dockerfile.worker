FROM node:22-bookworm-slim AS node
FROM nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONDONTWRITEBYTECODE=1
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip python3-venv git curl ca-certificates procps libnuma1 && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && npm install -g @openai/codex@0.163.0 @anthropic-ai/claude-code@2.1.302
RUN python3 -m pip install --no-cache-dir torch==2.5.1 --index-url https://download.pytorch.org/whl/cu124
RUN python3 -m pip install --no-cache-dir numpy==1.26.4 packaging requests pydantic PyYAML pandas scipy ninja setuptools
RUN apt-get update && apt-get install -y --no-install-recommends python3-dev && rm -rf /var/lib/apt/lists/*
RUN python3 -m pip install --no-cache-dir setuptools==75.8.0
RUN npm install --prefix /opt/codex-platform --no-audit --no-fund @openai/codex@0.163.0-linux-x64
RUN python3 -c "from pathlib import Path; p=[p for p in Path('/opt/codex-platform').rglob('codex') if p.is_file()]; assert len(p)==1 and p[0].read_bytes()[:4]==b'\\x7fELF'; t=Path('/usr/local/bin/codex'); t.unlink(); t.symlink_to(p[0])" && codex --version
RUN npm install --prefix /opt/claude-platform --no-audit --no-fund @anthropic-ai/claude-code-linux-x64@2.1.302
RUN python3 -c "from pathlib import Path; p=[p for p in Path('/opt/claude-platform').rglob('claude') if p.is_file()]; assert len(p)==1 and p[0].read_bytes()[:4]==b'\\x7fELF'; t=Path('/usr/local/bin/claude'); t.unlink(); t.symlink_to(p[0])" && claude --version
COPY upstream /opt/atrex
COPY bench /opt/atrex-bench
RUN git config --system --add safe.directory /opt/atrex/3rdparty/ncu-report-skill
RUN python3 -m pip install --no-deps --no-build-isolation -e /opt/atrex-bench
COPY bench_compat.py /opt/nexus-bench-compat.py
RUN python3 /opt/nexus-bench-compat.py
RUN ln -s /usr/bin/python3 /usr/local/bin/python && python --version
COPY worker.py /opt/nexus-worker.py
COPY manifest_compat.py /opt/atrex/nexus_manifest.py
RUN python3 /opt/atrex/nexus_manifest.py
ENV PATH=/usr/local/cuda/bin:/usr/local/bin:/usr/bin:/bin LD_LIBRARY_PATH=/driver:/usr/local/cuda/lib64 PYTHONPATH=/opt/atrex-bench/src
ENTRYPOINT ["python3", "-u", "/opt/nexus-worker.py"]
